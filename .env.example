# ========================================================
# MULTI-MODEL AI ROLE-BASED DISPATCH CONFIGURATION
# Phân quyền mô hình AI theo cấp bậc nhân sự (CEO - Manager - Executive)
# ========================================================

# --- CẤP 1: BAN GIÁM ĐỐC / CEO (Doraemon) ---
# Vai trò: Định hướng chiến lược, ra chỉ thị vĩ mô, điều phối 8 phòng ban
CEO_MODEL_PROVIDER="openai"            # openai | anthropic | gemini
CEO_MODEL="gpt-4o"                     # gpt-4o, gpt-4o-mini, o3-mini, codex
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# OPENAI_BASE_URL="https://api.openai.com/v1" # Tuỳ chọn proxy

# --- CẤP 2: TRƯỞNG PHÒNG / MANAGERS (8 Trưởng bộ phận: Dekisugi, Chaian, Shizuka, Suneo...) ---
# Vai trò: Quản lý chuyên môn sâu, tuân thủ SOP, phân tích 8D, bóc tách kỹ thuật, hợp đồng B2B
MANAGER_MODEL_PROVIDER="anthropic"     # anthropic | openai | gemini
MANAGER_MODEL="claude-3-5-sonnet-latest" # claude-3-5-sonnet-latest, claude-3-7-sonnet, claude-3-5-haiku
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1" # Tuỳ chọn proxy

# --- CẤP 3: CHUYÊN VIÊN & THỰC THI / EXECUTIVES (8 Chuyên viên: Jaiko, Tamako, Sewashi...) ---
# Vai trò: Thực thi tác vụ tốc độ cao, bóc tách bài in, kiểm tra kho, xử lý dữ liệu
EXECUTIVE_MODEL_PROVIDER="gemini"      # gemini | openai | anthropic
EXECUTIVE_MODEL="gemini-2.5-flash"     # gemini-2.5-flash, gemini-3.8-flash, gemini-2.5-pro
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-2.5-flash"      # Ghi đè chung cho Gemini

# --- APP CONFIG ---
APP_URL="MY_APP_URL"
