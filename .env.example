# ========================================================
# MULTI-MODEL AI ROLE-BASED DISPATCH CONFIGURATION
# Phân quyền mô hình AI theo cấp bậc nhân sự (CEO - Manager - Executive)
# ========================================================

# ========================================================
# [PRESET 1 - KHUYÊN DÙNG CHO GIAI ĐOẠN TEST: 100% MIỄN PHÍ VỚI GEMINI]
# Chỉ cần 1 API Key duy nhất từ https://aistudio.google.com/
# Hạn mức miễn phí: 15 lượt/phút, 1.500 lượt/ngày (0 VNĐ)
# ========================================================
CEO_MODEL_PROVIDER="gemini"
CEO_MODEL="gemini-2.5-pro"

MANAGER_MODEL_PROVIDER="gemini"
MANAGER_MODEL="gemini-2.5-flash"

EXECUTIVE_MODEL_PROVIDER="gemini"
EXECUTIVE_MODEL="gemini-2.5-flash"

GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# ========================================================
# [PRESET 2 - TEST MIỄN PHÍ SIÊU TỐC VỚI GROQ CLOUD + DEEPSEEK R1]
